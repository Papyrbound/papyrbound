      "500": { "$value": "#737373", "$type": "color", "$description": "Secondary text." },
      "600": { "$value": "#525252", "$type": "color", "$description": "Supporting text and icons." },
      "700": { "$value": "#404040", "$type": "color", "$description": "Strong secondary text." },
      "800": { "$value": "#262626", "$type": "color", "$description": "Primary dark surface." },
